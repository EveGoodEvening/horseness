{
  "name": "horseness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "docs:lint": "markdownlint-cli2 README.md docs/**/*.md",
    "c00:contract": "node scripts/c00-contract-gate.mjs",
    "vectors:verify": "pnpm --filter @horseness/domain run vectors:verify",
    "protocol:conformance": "pnpm --filter @horseness/protocol run protocol:conformance",
    "adapter:conformance": "pnpm --filter @horseness/adapter-kit run adapter:conformance",
    "generated:check": "pnpm --filter @horseness/protocol run generated:check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint && eslint scripts/*.mjs eslint.config.js --max-warnings=0",
    "test": "pnpm -r --if-present run test",
    "boundaries:check": "node scripts/boundaries-check.mjs",
    "host:validate:pi": "node scripts/host-feasibility/pi/validate.mjs --fixture tests/fixtures/hosts/pi/manifest.v1.json --mode hermetic",
    "host:validate:omp": "node scripts/host-feasibility/omp/validate.mjs --fixture tests/fixtures/hosts/omp/manifest.v1.json --mode hermetic",
    "host:validate:claude": "node scripts/host-feasibility/claude/validate.mjs --fixture tests/fixtures/hosts/claude/manifest.v1.json --mode hermetic",
    "host:validate:codex": "node scripts/host-feasibility/codex/validate.mjs --fixture tests/fixtures/hosts/codex/manifest.v1.json --mode hermetic",
    "host:harness:test": "node --test tests/host-feasibility/*.test.mjs tests/host-feasibility/**/*.test.mjs",
    "hosts:matrix:verify": "node scripts/host-feasibility/verify-matrix.mjs",
    "ci:require-os-receipts": "node scripts/ci-require-os-receipts.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "progress:cas": "node scripts/progress-cas.mjs"
  },
  "markdownlint-cli2": {
    "config": {
      "MD013": false,
      "MD022": false,
      "MD033": {
        "allowed_elements": [
          "ID"
        ]
      }
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@eslint/js": "9.33.0",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@types/node": "22.17.2",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "markdownlint-cli2": "0.18.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ]
}
