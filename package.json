{
  "name": "horseness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "docs:lint": "markdownlint-cli2 README.md docs/**/*.md",
    "c00:contract": "node scripts/c00-contract-gate.mjs",
    "vectors:verify": "pnpm --filter @horseness/domain run vectors:verify",
    "protocol:conformance": "pnpm --filter @horseness/protocol run protocol:conformance",
    "adapter:conformance": "pnpm --filter @horseness/adapter-kit run adapter:conformance",
    "generated:check": "pnpm --filter @horseness/protocol run generated:check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint && eslint scripts/*.mjs eslint.config.js --max-warnings=0",
    "test": "pnpm -r --if-present run test",
    "boundaries:check": "node scripts/boundaries-check.mjs",
    "host:validate:pi": "node scripts/host-feasibility/pi/validate.mjs --fixture tests/fixtures/hosts/pi/manifest.v1.json --mode hermetic",
    "host:validate:omp": "node scripts/host-feasibility/omp/validate.mjs --fixture tests/fixtures/hosts/omp/manifest.v1.json --mode hermetic",
    "host:validate:claude": "node scripts/host-feasibility/claude/validate.mjs --fixture tests/fixtures/hosts/claude/manifest.v1.json --mode hermetic",
    "host:validate:codex": "node scripts/host-feasibility/codex/validate.mjs --fixture tests/fixtures/hosts/codex/manifest.v1.json --mode hermetic",
    "host:harness:test": "node --test tests/host-feasibility/*.test.mjs tests/host-feasibility/**/*.test.mjs",
    "hosts:matrix:verify": "node scripts/host-feasibility/verify-matrix.mjs",
    "ci:require-os-receipts": "node scripts/ci-require-os-receipts.mjs",
    "host:smoke:pi": "pnpm --filter @horseness/adapter-pi run host:smoke",
    "host:smoke:omp": "pnpm --filter @horseness/adapter-omp run host:smoke",
    "host:smoke:claude": "pnpm --filter @horseness/adapter-claude run host:smoke",
    "host:smoke:codex": "pnpm --filter @horseness/adapter-codex run host:smoke",
    "test:security": "node --test --test-concurrency=1 tests/security/*.test.mjs",
    "test:system": "node --test --test-concurrency=1 tests/system/*.test.mjs",
    "test:closed-loop": "node tests/system/closed-loop.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "progress:cas": "node scripts/progress-cas.mjs",
    "compat-train:build": "node scripts/compat-train/build.mjs",
    "compat-train:verify": "node scripts/compat-train/verify.mjs",
    "bootstrap:build": "pnpm --filter @horseness/bootstrap run build",
    "install:blackbox": "node scripts/bootstrap/install-blackbox.mjs",
    "install:blackbox:offline": "node scripts/bootstrap/install-blackbox.mjs --offline",
    "doctor:hostile-no-side-effects": "pnpm --filter @horseness/installer exec node --import tsx ../../scripts/bootstrap/doctor-hostile.mjs",
    "uninstall:failure-matrix": "pnpm --filter @horseness/bootstrap exec node --import tsx ../../scripts/bootstrap/uninstall-failure-matrix.mjs",
    "cli:lifecycle:blackbox": "pnpm --filter @horseness/cli exec node --import tsx ../../scripts/bootstrap/cli-lifecycle-blackbox.mjs",
    "release:verify-root-ceremony": "node scripts/release/verify-root-ceremony.mjs",
    "release:verify-delegation": "node scripts/release/verify-delegation.mjs",
    "release:coherence": "node scripts/release/coherence.mjs",
    "release:build-twice": "node scripts/release/build-twice.mjs",
    "release:verify-sbom-provenance-signatures": "node scripts/release/verify-sbom-provenance-signatures.mjs",
    "live-gates:required": "node scripts/release/live-gates-required.mjs",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "release:verify-no-static-secrets": "node scripts/release/verify-no-static-secrets.mjs",
    "release:upload-immutable": "node scripts/release/upload-immutable.mjs",
    "release:verify-artifact-receipt": "node scripts/release/verify-artifact-receipt.mjs",
    "release:verify-commands": "node scripts/release/verify-commands.mjs",
    "release:materialize-bootstrap-trust-root": "node scripts/release/materialize-bootstrap-trust-root.mjs",
    "release:test": "node --test scripts/release/test/*.test.mjs"
  },
  "markdownlint-cli2": {
    "config": {
      "MD013": false,
      "MD022": false,
      "MD033": {
        "allowed_elements": [
          "ID"
        ]
      }
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "yaml": "2.8.1",
    "@eslint/js": "9.33.0",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@types/node": "22.17.2",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "markdownlint-cli2": "0.18.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ]
}
