{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horseness.dev/schemas/root-ceremony-v1.schema.json",
  "title": "Horseness RootCeremonyRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ceremonyId", "performedAt", "threshold", "rootKeys", "recovery", "witnesses", "custodyReceipts", "destructionReceipts", "delegation"],
  "properties": {
    "schema": { "const": "horseness.root-ceremony.v1" },
    "ceremonyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
    "performedAt": { "type": "string", "format": "date-time" },
    "threshold": { "const": "2-of-2" },
    "rootKeys": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/key" } },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "authorization", "sealedMediaReceiptDigests", "custodianIdentityDigests"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "authorization": { "const": "2-of-3" },
        "sealedMediaReceiptDigests": { "$ref": "#/$defs/digests", "minItems": 3 },
        "custodianIdentityDigests": { "$ref": "#/$defs/digests", "minItems": 3, "maxItems": 3 }
      }
    },
    "witnesses": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/witness" } },
    "custodyReceipts": { "$ref": "#/$defs/evidence" },
    "destructionReceipts": { "$ref": "#/$defs/evidence" },
    "delegation": { "$ref": "#/$defs/delegation" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "digests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["keyId", "algorithm", "publicKeyPem", "spkiFingerprint", "hardwareSerialDigest", "generationTool", "generationToolVersion", "entropySourceDigest"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
        "algorithm": { "const": "Ed25519" },
        "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
        "spkiFingerprint": { "$ref": "#/$defs/digest" },
        "hardwareSerialDigest": { "$ref": "#/$defs/digest" },
        "generationTool": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generationToolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "entropySourceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "identityDigest", "attestationDigest"],
      "properties": { "identity": { "type": "string", "minLength": 1, "maxLength": 128 }, "identityDigest": { "$ref": "#/$defs/digest" }, "attestationDigest": { "$ref": "#/$defs/digest" } }
    },
    "evidence": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" }, "sha256": { "$ref": "#/$defs/digest" } } } },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["keyId", "publicKeyPem", "validFromSequence", "validThroughSequence", "versionRange", "kmsPolicy", "approvals", "rootSignatures", "installerRootKeyId", "installerRootSignature"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" }, "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
        "validFromSequence": { "type": "integer", "minimum": 1 }, "validThroughSequence": { "type": "integer", "minimum": 1 },
        "versionRange": { "type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": { "minimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }, "maximum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" } } },
        "kmsPolicy": { "type": "object", "additionalProperties": false, "required": ["issuer", "repository", "workflow", "protectedEnvironment", "branch", "approvalCount", "keyResourceDigest"], "properties": { "issuer": { "const": "https://token.actions.githubusercontent.com" }, "repository": { "const": "EveGoodEvening/horseness" }, "workflow": { "const": "refs/heads/main:.github/workflows/release.yml" }, "protectedEnvironment": { "const": "release" }, "branch": { "const": "refs/heads/main" }, "approvalCount": { "const": 2 }, "keyResourceDigest": { "$ref": "#/$defs/digest" } } },
        "approvals": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["reviewerIdentityDigest", "approvalDigest"], "properties": { "reviewerIdentityDigest": { "$ref": "#/$defs/digest" }, "approvalDigest": { "$ref": "#/$defs/digest" } } } },
        "rootSignatures": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["keyId", "signature"], "properties": { "keyId": { "type": "string" }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" } } } },
        "installerRootKeyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
        "installerRootSignature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  }
}
