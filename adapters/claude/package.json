{
  "name": "@horseness/adapter-claude",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "native"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./native/plugin/*": "./native/plugin/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "node --import tsx --test test/*.test.ts",
    "host:smoke": "node --import tsx test/host-smoke.ts"
  },
  "dependencies": {
    "@horseness/adapter-kit": "workspace:1.0.0",
    "@horseness/domain": "workspace:1.0.0",
    "@horseness/orchestrator": "workspace:1.0.0",
    "@horseness/policy": "workspace:1.0.0",
    "@horseness/protocol": "workspace:1.0.0",
    "@horseness/sdk": "workspace:1.0.0",
    "@horseness/store-sqlite": "workspace:1.0.0"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
