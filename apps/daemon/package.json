{
  "name": "@horseness/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test:multiprocess": "node --import tsx --test test/multiprocess.test.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@horseness/domain": "workspace:*",
    "@horseness/orchestrator": "workspace:*",
    "@horseness/protocol": "workspace:*",
    "@horseness/store-sqlite": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
