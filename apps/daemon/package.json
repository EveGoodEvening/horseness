{
  "name": "@horseness/daemon",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "horseness-daemon": "./bin/horseness-daemon.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test:multiprocess": "node --import tsx --test test/multiprocess.test.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@horseness/domain": "workspace:1.0.0",
    "@horseness/orchestrator": "workspace:1.0.0",
    "@horseness/protocol": "workspace:1.0.0",
    "@horseness/store-sqlite": "workspace:1.0.0",
    "tsx": "4.20.5"
  },
  "devDependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin"
  ]
}
