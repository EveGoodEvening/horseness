{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horseness.dev/schemas/host-fixture-manifest-v1.json",
  "title": "HostFixtureManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "host", "artifact", "officialValidation", "requiredCapabilities", "sandbox", "provider", "livePolicy"],
  "properties": {
    "schemaVersion": { "const": "HostFixtureManifestV1" },
    "host": { "enum": ["pi", "omp", "claude", "codex"] },
    "artifact": { "$ref": "#/$defs/artifact" },
    "officialValidation": { "$ref": "#/$defs/officialValidation" },
    "requiredCapabilities": { "$ref": "#/$defs/capabilityArray" },
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "lifecycle", "workRoot", "network", "credentials", "allowedOutputs"],
      "properties": {
        "protocolVersion": { "const": "HostSandboxLifecycleV1" },
        "lifecycle": { "const": ["acquire", "verify-provenance", "install", "discover", "load", "inject-context", "attempt", "collect-receipt", "restart", "reconcile", "resume", "fork-switch", "uninstall", "audit-outputs"] },
        "workRoot": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "network": { "const": "disabled" }, "credentials": { "const": "disabled" },
        "allowedOutputs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" } }
      }
    },
    "provider": { "type": "object", "additionalProperties": false, "required": ["identity", "requestFixture", "responseFixture", "clock", "budget", "network", "credentials"], "properties": { "identity": {"type":"string","minLength":1}, "requestFixture":{"type":"string","minLength":1}, "responseFixture":{"type":"string","minLength":1}, "clock":{"type":"string","format":"date-time"}, "budget":{"type":"object"}, "network":{"const":"disabled"}, "credentials":{"const":"disabled"} } },
    "livePolicy": { "type":"object", "additionalProperties":false, "required":["credentialReference","publicationRequired","timeoutMs","budget"], "properties":{"credentialReference":{"type":"string","minLength":1},"publicationRequired":{"type":"boolean"},"timeoutMs":{"type":"integer","minimum":1},"budget":{"type":"object"}} }
  },
  "$defs": {
    "sha256": { "type":"string", "pattern":"^sha256:[0-9a-f]{64}$" },
    "artifact": { "type":"object", "additionalProperties":false, "required":["identity","version","registryUrl","packageIntegrity","archiveSha256","cacheKey","executable"], "properties":{"identity":{"type":"string","pattern":"^npm:.+@[^@]+$"},"version":{"type":"string","minLength":1},"registryUrl":{"type":"string","pattern":"^https://"},"packageIntegrity":{"type":"string","pattern":"^sha512-[A-Za-z0-9+/]+={0,2}$"},"archiveSha256":{"$ref":"#/$defs/sha256"},"cacheKey":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{5,127}$"},"executable":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},"sha256":{"$ref":"#/$defs/sha256"}}}} },
    "officialValidation": { "oneOf": [
      { "type":"object", "additionalProperties":false, "required":["kind","provenance","command"], "properties":{"kind":{"const":"independent-artifact"},"provenance":{"$ref":"#/$defs/artifact"},"command":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}} },
      { "type":"object", "additionalProperties":false, "required":["kind","provenance","command"], "properties":{"kind":{"const":"same-distribution-interface"},"provenance":{"type":"object","additionalProperties":false,"required":["artifactIdentity","interfacePath","interfaceSha256"],"properties":{"artifactIdentity":{"type":"string","pattern":"^npm:"},"interfacePath":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},"interfaceSha256":{"$ref":"#/$defs/sha256"}}},"command":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}} }
    ] },
    "capabilityArray": { "type":"array", "uniqueItems":true, "items":{"enum":["nativeArtifactLoad","contextInjection","deterministicProviderAttempt","receiptBinding","restartReconcile","resume","forkSwitch","uninstall"]} }
  }
}
