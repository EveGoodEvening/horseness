    "adapter:conformance": "node ./bin/test-runner.mjs"
  },
  "dependencies": {
    "@horseness/domain": "workspace:*",
    "@horseness/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
