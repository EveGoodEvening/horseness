{
  "dependencies": {
    "@horseness/domain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  },
  "exports": {
    ".": { "import": "./src/index.ts", "types": "./src/index.ts" },
    "./backup": { "import": "./src/backup/index.ts", "types": "./src/backup/index.ts" },
    "./import": { "import": "./src/import/index.ts", "types": "./src/import/index.ts" },
    "./migrations": { "import": "./src/migrations/index.ts", "types": "./src/migrations/index.ts" },
    "./recovery": { "import": "./src/recovery/index.ts", "types": "./src/recovery/index.ts" },
    "./restore": { "import": "./src/restore/index.ts", "types": "./src/restore/index.ts" },
    "./retention": { "import": "./src/retention/index.ts", "types": "./src/retention/index.ts" }
  },
  "name": "@horseness/store-sqlite",
  "private": true,
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "test": "node --import tsx --test test/*.test.ts test/migrations/*.test.ts",
    "test:crash-matrix": "node --import tsx --test test/crash-matrix.test.ts",
    "test:migration-0001": "node --import tsx --test test/migration-0001.test.ts",
    "test:recovery": "node --import tsx --test test/recovery/*.test.ts",
    "test:import-retention": "node --import tsx --test test/import/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0"
}
