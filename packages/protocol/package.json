{
  "name": "@horseness/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@horseness/domain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./bin/test-runner.mjs",
    "test:transports": "node --import tsx --test test/transports/**/*.test.ts",
    "protocol:conformance": "node --import tsx ./bin/conformance.ts",
    "generated:check": "node --import tsx ./bin/generate.ts --check",
    "generate": "node --import tsx ./bin/generate.ts"
  }
}
