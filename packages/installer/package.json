{
  "name": "@horseness/installer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:journal-crash": "node --import tsx --test test/journal/*.test.ts test/migrations/*.test.ts",
    "test:trust-consent": "node --import tsx --test test/trust/*.test.ts test/consent/*.test.ts"
  },
  "dependencies": {
    "@horseness/domain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
